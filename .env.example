# Copy to .env.local and fill in. All values are server-side only.

# Ontomorph DTP sandbox API key (dashboard -> Keys)
DTP_KEY=

# HOLON clinical-knowledge API key (dashboard -> Keys)
HOLON_KEY=

# The one sandbox twin's grant token (dashboard -> Sandbox)
SANDBOX_GRANT_TOKEN=

DTP_BASE_URL=https://sandbox-api.ontomorph.com
HOLON_API_URL=https://holon-api.ontomorph.com

# Any long random string; signs the referral tokens issued by /api/refer.
REFERRAL_SECRET=

# Base URL used to build the shareable referral link.
APP_BASE_URL=http://localhost:3000
